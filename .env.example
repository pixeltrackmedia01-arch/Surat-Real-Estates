# Copy to .env.local for development. Never commit real values.

# --- Storage -------------------------------------------------------------
# When both are set, leads, corrections and admin edits go to Supabase (server-side only).
# When unset: development stores to ./.data (clearly labelled), production refuses
# to accept leads and tells the visitor the enquiry was NOT sent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---------------------------------------------------------------
# Password for /admin and a long random secret used to sign the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /contact. Leave blank until a real monitored inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
